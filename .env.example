# ==============================================================================
# NetrIQ Platform Environment Configuration Template
# Copy this file to .env and configure your production values.
# NEVER commit .env to source control!
# ==============================================================================

# Environment Mode (development | staging | production)
ENVIRONMENT=production

# Database Settings (Internal MongoDB container in Docker compose)
MONGO_URI=mongodb://mongodb:27017/netriq_db
MONGO_DB=netriq_db

# Cryptographic Authentication Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=7

# Detection Engine Settings
ANOMALY_DETECTOR_ENABLED=True
ZERO_DAY_WEIGHT=0.8
HIGH_ANOMALY_THRESHOLD=70.0
RATE_LIMIT_DEFAULT=120

# Optional External Integrations (defaults to passive/noop mode)
FIREWALL_ADAPTER_TYPE=noop
QUARANTINE_MODE=noop
